# --- gitignore hardening (2026-11-11): never commit secrets or generated files ---
# Secrets and credentials
.env.*
*.env.bak*
*.pem
*.key
*.p12
*.p8
*.jks
*.keystore
key.properties
*service-account*.json
*-credentials.json
credentials/
*.tfvars
*secret*.local.*
google_request_tokens.json
.netrc
!.env.example
!.env.sample
!.env.template
!*.tfvars.example
